# Copy to .env (local) and add the same variable in your host's dashboard
# for production. PUBLIC_ prefix is required — Astro only exposes prefixed
# vars to client-side code, which is where the gtag snippet in Layout.astro
# needs it.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to ship with no analytics script at all.
PUBLIC_GA_MEASUREMENT_ID=
