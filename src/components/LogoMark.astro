---
import { Image } from "astro:assets";
import logoLight from "../assets/images/ninmangon-logo.png";
import logoDark from "../assets/images/ninmangon-dark-logo.png";

interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
const extra = className ? ` ${className}` : "";
---

<Image src={logoDark} alt="" width={size} height={size} class={`logo-img logo-img-dark${extra}`} />
<Image src={logoLight} alt="" width={size} height={size} class={`logo-img logo-img-light${extra}`} />
