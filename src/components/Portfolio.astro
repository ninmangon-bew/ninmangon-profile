---
import { Image } from 'astro:assets';
import { PORTFOLIO_COPY, PORTFOLIO_PROJECTS, type Lang } from '../content/copy';
import { portfolioImage } from '../content/portfolioImages';
import iconArrow from '../assets/vectors/icon-arrow.svg?raw';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = PORTFOLIO_COPY[lang];
const base = lang === 'en' ? '/portfolio/' : '/th/portfolio/';
---
<main id="main-content" class="portfolio-main">
  <div class="portfolio-shell">
    <header class="portfolio-intro">
      <p class="kicker">{t.kicker}</p>
      <h1>{t.title}</h1>
      <p class="portfolio-lead">{t.intro}</p>
    </header>
    {(['web', 'ux'] as const).map((category, index) => (
      <section id={category} class="portfolio-section" aria-labelledby={`${category}-title`}>
        <div class="portfolio-section-heading">
          <div><p class="kicker">0{index + 1} / {category === 'web' ? t.webLabel : t.uxLabel}</p><h2 id={`${category}-title`}>{category === 'web' ? t.webTitle : t.uxTitle}</h2></div>
          <p>{category === 'web' ? t.webIntro : t.uxIntro}</p>
        </div>
        <div class:list={['portfolio-grid', { 'portfolio-web-grid': category === 'web' }]}>
          {PORTFOLIO_PROJECTS.filter(p => p.category === category).map((project, i) => (
            <article class:list={['project-card', { 'project-featured': category === 'web' && i === 0 }]} style={`--project-accent:var(--${project.category === 'web' ? 'gold' : 'ux'}-text)`}>
              <a href={`${base}${project.slug}/`} class="project-link">
                <div class="project-image"><Image src={portfolioImage(project.slug)} alt={`${project.name} · ${project.platform}`} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 60vw" loading={category === 'web' && i === 0 ? 'eager' : 'lazy'} /></div>
                <div class="project-card-copy">
                  <p class="project-platform">{project.platform}</p>
                  <h3>{project.name}</h3>
                  <p class="project-summary">{project[lang].summary}</p>
                  <ul class="project-tags">{project.tags.map(tag => <li>{tag}</li>)}</ul>
                  <span class="project-read">{t.read} <span class="icon-arrow" aria-hidden="true" set:html={iconArrow} /></span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</main>
